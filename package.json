{
  "name": "umg-news-bot",
  "version": "0.1.0",
  "private": true,
  "description": "RSS feeds and WhatsApp community notifications for UMG Catanzaro degree course notice boards",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "poll:once": "node --disable-warning=ExperimentalWarning scripts/poll-once.js",
    "check:sources": "node scripts/check-sources.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "cheerio": "1.2.0",
    "pino": "10.4.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9"
  }
}
