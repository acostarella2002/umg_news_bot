# Public base URL of the RSS server (used inside the feeds), e.g. https://umg-news.duckdns.org
BASE_URL=http://localhost:8080
# HTTP port inside the container
PORT=8080
# Minutes between notice-board checks
POLL_MINUTES=15
# Set to false to run only the RSS feeds
WA_ENABLED=true
# The BOT's own WhatsApp Business number (international format, digits only), used once to get the pairing code
WA_PAIRING_NUMBER=39xxxxxxxxxx
# Random pause between two WhatsApp messages (seconds)
SEND_MIN_DELAY_S=8
SEND_MAX_DELAY_S=20
# Slower random pause (seconds) used while more than 10 messages are queued
SLOW_MIN_DELAY_S=120
SLOW_MAX_DELAY_S=180
# Hard cap of WhatsApp messages per hour
MAX_SENDS_PER_HOUR=40
# Days between "open the primary phone" reminders
KEEPALIVE_DAYS=6
# pino log level: fatal, error, warn, info, debug
LOG_LEVEL=info
